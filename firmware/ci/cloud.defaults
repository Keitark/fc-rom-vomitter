CONFIG_NESCART_CLOUD_PULL_ENABLE=y
CONFIG_NESCART_CLOUD_STA_SSID="ci-build-only"
CONFIG_NESCART_CLOUD_STA_PASSWORD="ci-build-password"
CONFIG_NESCART_CLOUD_ROM_URL="https://example.com/game.nes"
CONFIG_NESCART_CLOUD_BEARER_TOKEN=""
CONFIG_NESCART_CLOUD_POLL_SECONDS=60
CONFIG_NESCART_CLOUD_HTTP_TIMEOUT_MS=10000
# CONFIG_NESCART_CLOUD_ALLOW_CONSOLE_RELOAD is not set
# CONFIG_NESCART_CLOUD_ALLOW_INSECURE_HTTP is not set
